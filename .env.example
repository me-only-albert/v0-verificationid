# ===========================================
# Konfigurasi koneksi ke SQL Server 2012+ (via Tedious)
# ===========================================

SQL_SERVER_HOST=192.168.1.10
SQL_SERVER_PORT=1433
SQL_SERVER_USER=sa
SQL_SERVER_PASSWORD=your_password_here
SQL_SERVER_DATABASE=your_database_name

# Opsional: nama instance SQL Server (kosongkan jika tidak pakai instance)
# Contoh: SQLEXPRESS, MSSQLSERVER, atau nama instance custom
# SQL_SERVER_INSTANCE=SQLEXPRESS

# Enkripsi koneksi (untuk SQL Server 2012 on-premise, biasanya false)
# true = koneksi terenkripsi (perlu certificate yang valid)
# false = koneksi tanpa enkripsi
SQL_SERVER_ENCRYPT=false

# Trust server certificate (diperlukan jika SQL_SERVER_ENCRYPT=true dan cert self-signed)
SQL_SERVER_TRUST_CERT=true

# ===========================================
# Konfigurasi tabel/kolom (opsional, ada default-nya)
# ===========================================
# Override hanya jika nama tabel/kolom Anda berbeda dari default.
# Default: t5_Customer, MobilePhone, t5_Customer_verification_codes

# CUSTOMER_TABLE=t5_Customer
# CUSTOMER_PHONE_COLUMN=MobilePhone
# VERIFICATION_TABLE=t5_Customer_verification_codes
# VERIFICATION_PHONE_COLUMN=MobilePhone

