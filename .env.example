# ===========================================
# Konfigurasi koneksi ke SQL Server (2012+)
# ===========================================

SQL_SERVER_HOST=192.168.1.10
SQL_SERVER_PORT=1433
SQL_SERVER_USER=sa
SQL_SERVER_PASSWORD=your_password_here
SQL_SERVER_DATABASE=your_database_name

# Opsional: nama instance (kosongkan jika tidak pakai instance, mis. SQLEXPRESS)
# SQL_SERVER_INSTANCE=SQLEXPRESS

# Untuk SQL Server 2012 on-premise umumnya pakai:
SQL_SERVER_ENCRYPT=false
SQL_SERVER_TRUST_CERT=true

# ===========================================
# Konfigurasi tabel (opsional, ada default-nya)
# ===========================================
# Override hanya jika nama tabel/kolom Anda berbeda.
# CUSTOMER_TABLE=customers
# CUSTOMER_PHONE_COLUMN=phone
# VERIFICATION_TABLE=verification_codes
