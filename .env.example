# ===========================================
# Konfigurasi koneksi ke SQL Server 2012+ (via Tedious)
# ===========================================

SQL_SERVER_HOST=192.168.1.10
SQL_SERVER_USER=sa
SQL_SERVER_PASSWORD=your_password_here
SQL_SERVER_DATABASE=your_database_name

# PILIH SALAH SATU:
# - Jika menggunakan instance (misalnya SQLEXPRESS, mox_pusat, dll): isi SQL_SERVER_INSTANCE
# - Jika menggunakan port default atau custom: isi SQL_SERVER_PORT (jangan isi SQL_SERVER_INSTANCE)
# Catatan: Tidak boleh isi keduanya bersamaan (port dan instanceName saling eksklusif)

SQL_SERVER_INSTANCE=mox_pusat
# atau
# SQL_SERVER_PORT=1433

# Enkripsi koneksi (untuk SQL Server 2012 on-premise, biasanya false)
SQL_SERVER_ENCRYPT=false

# Trust server certificate (diperlukan jika cert self-signed)
SQL_SERVER_TRUST_CERT=true

# ===========================================
# Konfigurasi registry outlet
# ===========================================
# Aplikasi membaca DB_DAINTY_REPORTS.dbo.master_koneksi untuk:
# - mencari outlet dari URL /<outletCode>
# - mengambil koneksi pusat outletID=mox dengan isPusat=1

ROOT_SQL_SERVER_HOST=202.83.120.48
ROOT_SQL_SERVER_INSTANCE=sqlexpress
# Jika memakai port, isi ROOT_SQL_SERVER_PORT. Tedious akan mengutamakan port dibanding instance.
ROOT_SQL_SERVER_PORT=1433
ROOT_SQL_SERVER_USER=daintyuser
ROOT_SQL_SERVER_PASSWORD=your_password_here
ROOT_SQL_SERVER_DATABASE=DB_DAINTY_REPORTS

OUTLET_ID=mox
CENTRAL_CRM_DATABASE=DB_DAINTY_CRM
# Production sebaiknya false/kosong agar URL publik hanya memakai codeVerifikasi.
ALLOW_OUTLET_CODE_LOOKUP=false

# Override WA untuk pengetesan nomor tertentu.
# Kosongkan/hapus di production jika tidak diperlukan.
TEST_CUSTOMER_PHONE=085789850597
TEST_WHATSAPP_PHONE=087786577529

# ===========================================
# Konfigurasi tabel/kolom (opsional)
# ===========================================
# CUSTOMER_TABLE=t5_Customer
# CUSTOMER_PHONE_COLUMN=MobilePhone
# VERIFICATION_TABLE=t5_Customer_verification_codes
# VERIFICATION_PHONE_COLUMN=MobilePhone

